#!/usr/bin/env python3
"""Run the opt-in owned corpus benchmark; never build the root-owned frontend."""
import argparse
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def classify(value, limit, eligible):
    if not eligible or value is None:
        return "unmeasured"
    return "pass" if value < limit else "fail"


def classifications(result):
    measurements = (result or {}).get("measurements") or {}
    http = measurements.get("http", {})
    valid = bool(measurements.get("overlap_verified")) and result.get("cleanup_completed") is True and not result.get("failures")
    targets = {
        "query p95 < 300 ms at five sessions": (http.get("catalog_http", {}).get("p95_ms"), 300),
        "idle RSS < 250 MiB": (measurements.get("idle_rss_bytes"), 250 * 1024**2),
        "mixed RSS < 1 GiB": (measurements.get("mixed_rss_bytes") or None, 1024**3),
        "warm page delivery < 1 s": (http.get("warm_reader_http", {}).get("max_ms"), 1000),
    }
    return {name: {"fixture result": classify(value, limit, valid),
                   "reference-environment acceptance": "unmeasured"}
            for name, (value, limit) in targets.items()}


def cgroup_limits():
    # v2 hierarchical limits can be tighter at any ancestor.
    entry = next((line.split(":", 2)[2] for line in Path("/proc/self/cgroup").read_text().splitlines()
                  if line.startswith("0::")), None)
    if entry is None:
        return {"status": "unmeasured (cgroup v2 unavailable)"}
    mount = Path("/sys/fs/cgroup")
    current = mount / entry.lstrip("/")
    if not current.is_dir():
        return {"status": "unmeasured (cgroup mount not resolved)"}
    limits = []
    while current == mount or mount in current.parents:
        values = {name: (current / name).read_text().strip() if (current / name).is_file() else "unavailable"
                  for name in ("cpu.max", "cpuset.cpus.effective", "memory.max")}
        limits.append({"cgroup": str(current.relative_to(mount)), **values})
        if current == mount:
            break
        current = current.parent
    return {"hierarchy": limits}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--debug", action="store_true", help="debug smoke run; requires BENCHMARK_FILES=1000")
    parser.add_argument("--binary", action="store_true", help="run the real libraryd executable over loopback")
    parser.add_argument("--assert-reference-host", action="store_true", help="operator asserts this is the reference host; synthetic fixtures still cannot establish acceptance")
    parser.add_argument("--host-metadata", help="operator-provided reference host description")
    parser.add_argument("--network-metadata", help="operator-provided LAN path description")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    os.chdir(root)
    count = int(os.environ.get("BENCHMARK_FILES", "50000"))
    if args.debug and count != 1000:
        parser.error("--debug requires explicit BENCHMARK_FILES=1000; it is not 50k validation")
    if not 1000 <= count <= 50000:
        parser.error("BENCHMARK_FILES must be 1000..=50000; values are never silently capped")
    if sys.platform != "linux":
        parser.error("Linux /proc and local filesystem accounting are required")
    if not args.debug and not (root / "web/dist/index.html").is_file():
        parser.error("root task must finish the frontend build before the release benchmark")
    usage = shutil.disk_usage(root)
    if usage.free < 3 * 1024**3:
        parser.error("at least 3 GiB free space is required for benchmark data; release build needs extra")
    filesystem = subprocess.check_output(["stat", "-f", "-c", "%T", str(root)], text=True).strip()
    if filesystem not in {"ext2/ext3", "ext4", "btrfs", "xfs", "zfs", "tmpfs", "overlayfs"}:
        parser.error(f"unapproved filesystem type {filesystem!r}; benchmark must remain on local storage")
    versions = {}
    for name, command in {
        "rustc": ["rustc", "--version"], "cargo": ["cargo", "--version"],
        "bun_pinned": [str(root / "scripts/bun"), "--version"],
        "pdfinfo": ["pdfinfo", "-v"], "pdftoppm": ["pdftoppm", "-v"],
        "prlimit": ["prlimit", "--version"],
        "7zip": ["7z", "i"],
    }.items():
        completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=True)
        versions[name] = next(line for line in completed.stdout.splitlines() if line.strip())
    versions["python"] = sys.version.split()[0]
    cpu = next((line.split(":", 1)[1].strip() for line in Path("/proc/cpuinfo").read_text().splitlines()
                if line.startswith("model name")), "unreported")
    memory = next(line for line in Path("/proc/meminfo").read_text().splitlines() if line.startswith("MemTotal:"))
    environment = {"utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                   "cpu_model": cpu, "logical_cpus": os.cpu_count(), "memory": memory,
                   "filesystem_type": filesystem, "architecture": os.uname().machine,
                   "kernel_release": os.uname().release, "tools": versions,
                   "files": count, "profile": "debug" if args.debug else "release",
                   "applied_cgroup_limits": cgroup_limits(),
                   "cpu_affinity": sorted(os.sched_getaffinity(0)),
                   "corpus_and_state_mount": subprocess.check_output(["findmnt", "-T", str(root), "-no", "TARGET,FSTYPE,SOURCE"], text=True).strip(),
                   "network_path": "loopback" if args.binary else "in-process",
                   "artifact": "libraryd executable" if args.binary else "in-process router",
                   "fixture_class": "synthetic fixture", "reference_host_asserted": args.assert_reference_host,
                   "host_metadata": args.host_metadata, "network_metadata": args.network_metadata,
                   "cache_state": "warm after explicit requests; OS cache not dropped" if args.binary else
                                  "fresh reader cache for cold; warm repeated; OS cache not dropped"}
    command = ["cargo", "test"]
    if not args.debug:
        command += ["--release", "--features", "embedded-ui"]
    command += ["--test", "benchmark", "--", "--ignored", "--exact",
                "owned_binary_loopback_performance" if args.binary else "owned_50000_file_performance", "--nocapture"]
    command = ["nice", "-n", "10"] + command
    command.insert(4, "--offline")
    print(json.dumps(environment), flush=True)
    print("Running: " + " ".join(command), flush=True)
    report = None
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) as child:
        assert child.stdout is not None
        for line in child.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            prefix = "BENCHMARK_BINARY_RESULT " if args.binary else "BENCHMARK_RESULT "
            if prefix in line:
                report = json.loads(line.split(prefix, 1)[1])
        status = child.wait()
    if status == 0 and report is None:
        raise RuntimeError("runner returned success without benchmark evidence")
    result_file = root / "docs/local/benchmark-results.md"
    result_file.parent.mkdir(parents=True, exist_ok=True)
    with result_file.open("a") as output:
        output.write("\n## Recorded run " + environment["utc"] + "\n\n")
        output.write(f"{'Full target corpus' if count == 50000 else 'Reduced corpus, not 50k validation'}; "
                     f"{environment['profile']}; exit status {status}.\n\n")
        output.write("Command: `" + " ".join(command) + "`\n\n")
        output.write("```json\n" + json.dumps({"environment": environment, "result": report,
                                                  "acceptance_targets": classifications(report if args.binary else None),
                                                  "failures": (report or {}).get("failures", []) + ([f"runner exit status {status}"] if status else [])}, indent=2) + "\n```\n")
    return status


if __name__ == "__main__":
    raise SystemExit(main())
